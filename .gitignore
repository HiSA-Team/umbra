
# These are backup files generated by rustfmt
**/*.rs.bk

# OS / editor / Python detritus
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.pyc

# Ignore build artifacts
lib/*

# Explicitly track FreeRTOS-Kernel submodule despite lib/* rule
!host/stm32l552/freertos/lib/FreeRTOS-Kernel

# Ignore deprecated
deprecated

# Ignore tmp files and topo
tmp
todo

# Host build artifacts (per platform/app)
host/stm32l552/bare_metal/bin/*
host/stm32l552/bare_metal/obj/*
host/stm32l552/freertos/bin/*
host/stm32l552/freertos/obj/*
host/stm32n657/bare_metal/bin/*
host/stm32n657/bare_metal/obj/*
host/stm32n657/freertos/bin/*
host/stm32n657/freertos/obj/*
host/stm32n657/object_detection/bin/*
host/stm32n657/object_detection/obj/*

# ST upstream clone — vendored subset is committed under
# host/stm32n657/object_detection/{Application,Middlewares,STM32Cube_FW_N6,Model}
host/STM32N6-GettingStarted-ObjectDetection/

# T3 smoke-test transient output (golden_uart.log is tracked)
tools/last_uart.log
tools/last_uart_fault.log

# Local-only: every docs/ asset (ADRs, guardrails, HANDOFF, formal
# models, datasheets, working artifacts) lives outside the published
# repo. The user-facing documentation surface is the mdBook under
# `book/` (sources tracked, build output gitignored).
docs/
.claude/

# === Build artefacts (host applications) ===

# TACLeBench intermediate build outputs (not source)
host/stm32l552/taclebench/obj/
host/stm32l552/taclebench/app/

# Tock host build artefacts (Cargo.lock churns during smoke tests; not stable)
host/stm32l552/tock/target/

# llvm-cov reports (host-coverage runs)
lcov.info
target/llvm-cov/

# Workspace target/ at repo root (created by xtask + future workspace builds).
# Per-crate target/ under src/.../{boot,drivers}/target/ stay covered by the
# rule above, but the workspace root creates an additional one here.
/target/

# OTFDEC key/nonce material (local-only, never committed)
tools/otfdec_key.bin
tools/otfdec_nonce.bin

# Master key — generated locally by `python3 tools/gen_key.py`. The matching
# Rust constants (src/.../boot/src/master_key.rs) stay tracked so a fresh
# clone can `cargo check` before key generation; the binary form is local-only.
tools/master_key.bin

# Build artifacts under host/<mcu>/bare_metal/ (NEVER_DO #11)
host/*/bare_metal/lib/
host/*/bare_metal/*.bin

# RISC-V (riscv32) bare-metal host is a Cargo crate — Cargo build output dir.
host/riscv32/bare_metal/target/

# RISC-V (riscv32) TockOS S-guest overlay workspace — Cargo build output dir.
host/riscv32/tock/target/

